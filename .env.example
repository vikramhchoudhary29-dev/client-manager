# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public Firebase Web app configuration (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin service account values (server-side only; never use NEXT_PUBLIC_ here)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Comma-separated allowlist of verified administrator email addresses
ADMIN_EMAILS="you@example.com"
APP_URL="http://localhost:3000"
